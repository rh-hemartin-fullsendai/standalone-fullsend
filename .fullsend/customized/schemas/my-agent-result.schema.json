{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "My Agent Result",
  "type": "object",
  "required": ["status"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["complete", "needs_input", "error"]
    },
    "result": {
      "type": "object"
    },
    "comment": {
      "type": "string",
      "maxLength": 4000
    }
  }
}
